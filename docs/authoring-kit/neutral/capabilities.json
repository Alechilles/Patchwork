{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "Patchwork",
  "profile": "neutral",
  "contractVersion": 2,
  "definitionSchema": "./patch-definition.schema.json",
  "versionFieldRequired": false,
  "supportedFormatVersions": [1, 2],
  "macroDescriptorVersion": null,
  "targetSelectors": {
    "exact": true,
    "globPrefix": "glob:",
    "tokens": {
      "*": "zero or more characters within one path segment",
      "**": "zero or more path segments",
      "?": "one character within one path segment"
    }
  },
  "operations": [
    "Add",
    "Merge",
    "Replace",
    "Remove",
    "Insert",
    "ReplaceMatching",
    "RemoveMatching",
    "MoveMatching",
    "MergeMatching",
    "UpsertMatching",
    "OverlayFromAsset",
    "MergeObjectFromAsset",
    "Macro"
  ],
  "conditions": [
    "ModInstalled",
    "AssetExists",
    "AssetMissing",
    "TargetExists",
    "TargetProvidedBy",
    "ModVersion",
    "ServerVersion",
    "GameVersion",
    "JsonPathExists",
    "JsonPathEquals",
    "All",
    "Any",
    "Not"
  ],
  "TargetProvidedBy": {
    "conditionKey": "TargetProvidedBy",
    "value": "winning-source-pack-id",
    "comparison": "exact-case-sensitive"
  },
  "macroDescriptors": {
    "builtInVersion": null,
    "hostProvided": true,
    "location": "Server/Patchwork/Authoring/Macros/**/*.json"
  }
}
