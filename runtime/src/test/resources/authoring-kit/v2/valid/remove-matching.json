{
  "FormatVersion": 2,
  "Id": "remove-matching",
  "Target": "Server/Test.json",
  "Operations": [
    {
      "Op": "RequireFormat",
      "Version": 2
    },
    {
      "Id": "remove",
      "Op": "RemoveMatching",
      "Path": "/items",
      "Match": {
        "$Equals": {
          "id": "remove"
        }
      },
      "MatchPolicy": "All"
    }
  ]
}
